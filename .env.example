DATABASE_URL=postgres://rasd:rasd@127.0.0.1:5432/rasd
# Signs the login session cookie (openssl rand -hex 32)
AUTH_SECRET=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Header x-device-key expected from ESP32 devices
INGEST_API_KEY=change-me
# Server-side demo simulator: on | off, interval in ms
SIMULATOR=on
SIMULATOR_INTERVAL_MS=4000
